# Copy this file to .env for local testing. On Railway, set these in the
# service's Variables tab instead (do NOT commit a real .env).

# Required — from the Discord Developer Portal (Bot tab -> Reset Token)
DISCORD_TOKEN=paste-your-bot-token-here

# Your server ID (right-click the server icon -> Copy Server ID, with Developer Mode on).
# Makes slash commands appear instantly. Leave blank to sync globally (slow).
GUILD_ID=

# The two verification channels (already set to your IDs).
GATE_CHANNEL_ID=1570053267621417060
CAPTCHA_CHANNEL_ID=1569526459176067072

# Role names the bot creates/uses. Change only if you want different names.
VERIFYING_ROLE_NAME=Verifying
VERIFIED_ROLE_NAME=Verified

# How long (seconds) a captcha code stays valid.
CAPTCHA_TTL=300
